{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "hexo generate && node scripts/merge-assets.js && node scripts/cache-bust.js && node scripts/site-integrity.js",
    "clean": "hexo clean",
    "server": "hexo server",
    "lint": "eslint scripts source/js tests eslint.config.js --max-warnings 0",
    "typecheck": "tsc --project jsconfig.json",
    "test": "node --test tests/*.test.js && node tests/test-mobile-article-layout.js",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "hexo": {
    "version": "7.3.0"
  },
  "dependencies": {
    "hexo": "^7.0.0",
    "hexo-deployer-git": "^4.0.0",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-feed": "^4.0.0",
    "hexo-generator-index": "^3.0.0",
    "hexo-generator-search": "^2.4.3",
    "hexo-generator-sitemap": "^3.0.1",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^6.0.0",
    "hexo-renderer-stylus": "^3.0.1",
    "hexo-server": "^3.0.0",
    "hexo-tag-aplayer": "^3.0.4",
    "hexo-theme-butterfly": "^5.5.2",
    "hexo-wordcount": "^6.0.1",
    "js-yaml": "4.3.2",
    "meting": "^2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/js-yaml": "4.0.9",
    "@types/jsdom": "21.1.7",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
